# ============================================================
# Nesh Property System — Frontend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# Backend API URL (must match backend PORT)
VITE_API_URL=http://localhost:5000/api/v1

# Supabase — get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# App display name
VITE_APP_NAME=Nesh Property Management
