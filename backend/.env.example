# ============================================================
# Nesh Property System — Backend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Supabase — get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWT — generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string
JWT_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=30d

# CORS
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
